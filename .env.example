# Public origin of the standalone Cloudflare evidence-room Worker.
NEXT_PUBLIC_EVIDENCE_ROOM_URL=http://localhost:8787

# Optional: comma-separated development hosts allowed by Next.js (for example,
# a private tailnet hostname). Do not commit a personal hostname.
# ALLOWED_DEV_ORIGINS=your-development-host.example

# Cloudflare Worker only: Vercel AI Gateway authentication for reviewed video proposals.
# Set it with `pnpm --dir room-worker exec wrangler secret put AI_GATEWAY_API_KEY`
# rather than exposing it to either browser or the Vercel app.
# AI_GATEWAY_API_KEY=

# Server-only on the Vercel app: a separate, hard-budgeted Gateway key for one
# bounded Exa search. Never expose this through a NEXT_PUBLIC_ variable.
# AI_GATEWAY_DISCOVERY_API_KEY=

# Server-only: public TikTok, Instagram Reels, and YouTube discovery leads.
# Public results remain link-only until claim-reviewed; never expose this key to the browser.
# SCRAPECREATORS_API_KEY=
