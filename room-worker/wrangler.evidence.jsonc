{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webmcp-product-evidence",
  "main": "src/evidence-index.ts",
  "compatibility_date": "2026-08-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "CASES",
        "class_name": "ProductEvidenceCaseObject",
      },
    ],
  },
  "exports": {
    "ProductEvidenceCaseObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "stream": {
    "binding": "STREAM",
  },
  "ratelimits": [
    {
      "name": "CASE_CREATION_PER_CLIENT_RATE_LIMITER",
      "namespace_id": "27182811",
      "simple": {
        "limit": 12,
        "period": 60,
      },
    },
    {
      "name": "CASE_CREATION_GLOBAL_RATE_LIMITER",
      "namespace_id": "27182812",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    "EVIDENCE_CASE_TTL_SECONDS": "86400",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
