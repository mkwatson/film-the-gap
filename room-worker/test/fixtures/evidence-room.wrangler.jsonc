{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webmcp-evidence-room-acceptance",
  "main": "../../src/index.ts",
  "compatibility_date": "2026-08-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "EvidenceRoom",
      },
      {
        "name": "CASES",
        "class_name": "ProductEvidenceCaseObject",
      },
    ],
  },
  "exports": {
    "EvidenceRoom": {
      "type": "durable-object",
      "storage": "sqlite",
    },
    "ProductEvidenceCaseObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "services": [
    {
      "binding": "STREAM_OUTBOUND",
      "service": "webmcp-evidence-services-fixture",
    },
    {
      "binding": "AI_ANALYSIS_OUTBOUND",
      "service": "webmcp-evidence-services-fixture",
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    "ROOM_TTL_SECONDS": "7200",
    "EVIDENCE_CASE_TTL_SECONDS": "86400",
  },
}
