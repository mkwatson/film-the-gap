{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "webmcp-evidence-room-acceptance",
  "main": "../../src/evidence-index.ts",
  "compatibility_date": "2026-08-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "CASES",
        "class_name": "ProductEvidenceCaseObject",
      },
    ],
  },
  "exports": {
    "ProductEvidenceCaseObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "d1_databases": [
    {
      "binding": "EVIDENCE_LIBRARY",
      "database_name": "webmcp-evidence-library-acceptance",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
    },
  ],
  "services": [
    {
      "binding": "STREAM_OUTBOUND",
      "service": "webmcp-evidence-services-fixture",
    },
    {
      "binding": "AI_ANALYSIS_OUTBOUND",
      "service": "webmcp-evidence-services-fixture",
    },
    {
      "binding": "PAGE_READER_OUTBOUND",
      "service": "webmcp-evidence-services-fixture",
    },
  ],
  "ratelimits": [
    {
      "name": "CASE_CREATION_PER_CLIENT_RATE_LIMITER",
      "namespace_id": "27182821",
      "simple": {
        "limit": 12,
        "period": 60,
      },
    },
    {
      "name": "CASE_CREATION_GLOBAL_RATE_LIMITER",
      "namespace_id": "27182822",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    "PUBLIC_EVIDENCE_ORIGIN": "https://rooms.example",
    "EVIDENCE_CASE_TTL_SECONDS": "86400",
    "PAGE_READER_SHARED_SECRET": "acceptance-only-page-reader-secret",
  },
}
